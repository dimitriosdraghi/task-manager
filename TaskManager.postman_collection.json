{
  "info": {
    "name": "Task Manager API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All Task Manager requests. Order: 1. Auth → 2. Tasks → 3. Errors → 4. Admin. The login requests save the token automatically."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register alex",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "201 Created",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alex\",\n  \"password\": \"alex123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Register maria",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "201 Created",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"maria\",\n  \"password\": \"maria123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login alex",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "200 OK + token (saved to {{token}})",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alex\",\n  \"password\": \"alex123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login maria",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "200 OK + token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"maria\",\n  \"password\": \"maria123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Tasks",
      "item": [
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "201 Created",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy groceries\",\n  \"description\": \"Milk, bread\"\n}"
            }
          }
        },
        {
          "name": "Get my tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "200 OK"
          }
        },
        {
          "name": "Get task 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "1"
              ]
            },
            "description": "200 OK (403 if not yours, 404 if missing)"
          }
        },
        {
          "name": "Update task 1 (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "1"
              ]
            },
            "description": "Replaces all fields",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy groceries\",\n  \"description\": \"Milk, bread, eggs\",\n  \"completed\": false\n}"
            }
          }
        },
        {
          "name": "Complete task 1 (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "1"
              ]
            },
            "description": "Updates only 'completed'",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed\": true\n}"
            }
          }
        },
        {
          "name": "Delete task 1",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "1"
              ]
            },
            "description": "204 No Content"
          }
        }
      ]
    },
    {
      "name": "3. Errors",
      "item": [
        {
          "name": "No token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "401 Unauthorized",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Empty title → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "400 Bad Request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\"\n}"
            }
          }
        },
        {
          "name": "Missing task → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "999"
              ]
            },
            "description": "404 Not Found"
          }
        },
        {
          "name": "Wrong password → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "401 Unauthorized, no token is issued",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alex\",\n  \"password\": \"wrong\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Register same username → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "409 Conflict",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alex\",\n  \"password\": \"alex123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "4. Admin",
      "item": [
        {
          "name": "All tasks (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "tasks"
              ]
            },
            "description": "200 with an ADMIN token, 403 with a USER token"
          }
        }
      ]
    }
  ]
}